# Copia este archivo a .env y completa lo que uses.

# Verificación de imágenes con IA de visión (opcional).
# Si no se define, se usa un verificador heurístico local (Módulo 9).
ANTHROPIC_API_KEY=

# Búsqueda de imágenes vía Google Custom Search (opcional).
# Si no se define, se usa DuckDuckGo (sin API key) como proveedor por defecto.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Nivel de logging: TRACE, DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
