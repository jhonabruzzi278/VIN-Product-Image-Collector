__pycache__/
*.pyc
.venv/
venv/
.env

# Listados de productos reales del usuario: pueden contener catálogo/negocio
# propietario y este repo es público. Solo se versiona el ejemplo genérico.
input/*
!input/.gitkeep
!input/ejemplo_productos.csv
output/images/*
!output/images/.gitkeep
output/thumbnails/*
!output/thumbnails/.gitkeep
output/catalogo.csv
output/reporte.html
cache/*
!cache/.gitkeep
logs/*
!logs/.gitkeep
database/*.db
database/*.sqlite3
!database/.gitkeep
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Bases de datos generadas en ejecución (regenerables)
catalog.db
*.db
*.sqlite
